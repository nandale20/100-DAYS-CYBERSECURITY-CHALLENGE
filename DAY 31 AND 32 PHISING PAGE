CSS FILE FOR MY INSTA PHISING PAGE 

.main {
  display: flex;
  height: 100vh;
  width: 100vw;
  background-color: grey;
  align-items: center;
  justify-content: flex-start; /* aligns items to the left */
}
.imgg {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 400px; /* control image width */
  height: 100%;
}

.imgg img {
  width: 100%;
  height: auto;
  object-fit: contain;
}


.formm {
  width: 350px;
  background-color: #ffffff;
  padding: 40px 30px;
  border-radius: 10px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  font-family: 'Segoe UI', Tahoma, sans-serif;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.a
{
    padding-bottom:10px;
}     
input {
  width: 100%;
  height: 40px;
  margin: 10px 0;
  padding: 0 10px;
  border: 1px solid #ccc;
  border-radius: 6px;
  font-size: 14px;
}
.i {
  width: 100%;
  height: 40px;
  margin-top: 10px;
  background-color: #3897f0;
  color: white;
  border: none;
  border-radius: 6px;
  font-weight: bold;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.i:hover {
  background-color: #2f80ed;
}
.face {
  display: flex;
  align-items: center;
  margin: 20px 0;
  font-size: 14px;
  color: #385185;
  cursor: pointer;
}

.face img {
  margin-right: 8px;
}

.forget, .dont a {
  font-size: 12px;
  color: #00376b;
  text-decoration: none;
}

.forget:hover, .dont a:hover {
  text-decoration: underline;
}
h1 {
  font-family: 'Segoe UI', Tahoma, sans-serif;
  font-size: 32px;
  margin-bottom: 20px;
  color: #262626;
}

p {
  font-size: 12px;
  color: #999;
  margin: 10px 0;
  text-align: center;
}
.forget
{
  padding-left: 100px;
  margin-bottom:20px;
}
.dont
{
    
    padding-left: 60px;
}
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  height: 100%;
  width: 100%;
}
